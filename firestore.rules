rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Todos os dados de um bar (mídias, playlists, promoções, agenda de
    // shows, ranking de karaokê, fila de palco e config) são públicos para
    // leitura (necessário para o player exibir conteúdo sem login) e
    // restritos a usuários autenticados para escrita (painel admin).
    match /bares/{barId} {
      allow read: if true;
      allow write: if request.auth != null;

      match /{document=**} {
        allow read: if true;
        allow write: if request.auth != null;
      }
    }
  }
}
